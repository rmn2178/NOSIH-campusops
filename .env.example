# ---------------------------------------------------------------------------
# NOSIH environment template
# Copy to .env (gitignored). Never commit real keys.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...          # server-side only, never in the browser
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...    # alias used by scripts / Edge Functions
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=complaint-evidence

# Direct Postgres connection for migrations/seeds/verification scripts
DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# AI provider — read from Supabase Vault (`xai_api_key`), used by the in-database AI layer.
# A `gsk_...` key is a Groq key and auto-routes to api.groq.com.
# An `xai-...` key routes to api.x.ai. Set LLM_MODEL to override the default model.
XAI_API_KEY=
GROK_MODEL=openai/gpt-oss-120b
LLM_MODEL=

# Browser portals read only these two (VITE_ prefix = shipped to the client).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional Edge Functions (not required; AI runs in-database, cron handles schedules)
INBOUND_EMAIL_SECRET=
CRON_SECRET=

# Local development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
FLOOR_INDEX_MODE=1-indexed
TIMETABLE_SOLVER_SECONDS=90
