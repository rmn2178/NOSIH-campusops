# Supabase project
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=complaint-evidence

# Direct Postgres connection used by seeding / maintenance scripts
DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# AI provider (server-side only; never expose to the browser).
# Stored in Supabase Vault as `xai_api_key`. A `gsk_` key is detected as a
# Groq key and routed to api.groq.com automatically; otherwise x.ai is used.
XAI_API_KEY=
GROK_MODEL=openai/gpt-oss-120b
# Optional override for the model the in-database AI layer calls.
LLM_MODEL=

# Edge Function shared secrets
INBOUND_EMAIL_SECRET=
CRON_SECRET=

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
FLOOR_INDEX_MODE=1-indexed
TIMETABLE_SOLVER_SECONDS=90
