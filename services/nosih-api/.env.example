# ---------------------------------------------------------------------------
# NOSIH API / scripts template
# Copy to services/nosih-api/.env (gitignored). Never commit real keys.
# ---------------------------------------------------------------------------

# Postgres connection for migrations, seeds and verification scripts.
# When db.<project-ref>.supabase.co has no IPv6 route, use the Supavisor pooler:
#   postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Supabase project (secret and service-role keys stay server-side)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=complaint-evidence

# App
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
JWT_SECRET=replace-with-a-long-random-string
IDENTITY_VAULT_FERNET_KEY=
UPLOAD_DIR=uploads
FLOOR_INDEX_MODE=1-indexed
TIMETABLE_SOLVER_SECONDS=90

# The in-database AI layer reads its key pool from Supabase Vault.
# Rotate keys with scripts/set_ai_key.py; these values are only a local mirror.
XAI_API_KEY=
GROK_MODEL=openai/gpt-oss-120b
LLM_MODEL=
