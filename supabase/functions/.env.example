# Set these with: supabase secrets set --env-file supabase/functions/.env
# The same key also lives in Supabase Vault as `xai_api_key`, which is what the
# in-database AI layer reads.
# Grok handles moderation, extraction and classification. A `gsk_` key is
# detected as a Groq key and routed to api.groq.com automatically.
XAI_API_KEY=
GROK_MODEL=openai/gpt-oss-120b
# Shared secrets for the two unauthenticated endpoints.
INBOUND_EMAIL_SECRET=
CRON_SECRET=
