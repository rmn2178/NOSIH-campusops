# Complaint portal — browser bundle. Only the publishable key belongs here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Live AI (assistant + comment moderation) runs inside Supabase, not Vercel.
# The Groq key pool lives in Supabase Vault as `ai_api_keys`; the browser calls
# rpc_ai_chat / rpc_chat_intake / rpc_post_comment with the publishable key.
# Never add XAI_API_KEY or a service-role key to this file or to Vercel.
